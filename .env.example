# Copy this file to .env and fill in real values. Never commit .env itself.

# Flask secret key -- used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# Set to 0 in production
FLASK_DEBUG=1

# Port the dev server listens on
PORT=5000

# Token required to upload a replacement resume PDF at /resume/upload
# Leave blank to keep resume uploads disabled.
ADMIN_UPLOAD_TOKEN=

# Optional: SMTP settings if you wire up real email delivery for the
# contact form (not required -- messages are logged to instance/messages.log
# by default). See README "Contact form email delivery" section.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_RECEIVER_EMAIL=dhivyasubash19@gmail.com
